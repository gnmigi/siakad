@section('custom-js')
    <script src="{{ asset('dist') }}/assets/extensions/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            // Auto-submit form when filter changes (immediate for dropdowns)
            $('#prodi_filter, #kelas_filter, #semester_filter, #takhasus_filter').on('change', function() {
                showLoadingState();
                $('#filterForm').submit();
            });

            // Real-time search with AJAX
            let searchTimeout;
            $('#search').on('input', function() {
                clearTimeout(searchTimeout);
                const searchTerm = $(this).val();
                
                searchTimeout = setTimeout(function() {
                    performRealTimeSearch(searchTerm);
                }, 300); // 300ms delay to avoid too many requests
            });

            // Function to perform real-time search
            function performRealTimeSearch(searchTerm) {
                console.log('Performing search for:', searchTerm);
                showLoadingState();
                
                // Get current filter values
                const filters = {
                    search: searchTerm,
                    prodi_filter: $('#prodi_filter').val(),
                    kelas_filter: $('#kelas_filter').val(),
                    semester_filter: $('#semester_filter').val(),
                    takhasus_filter: $('#takhasus_filter').val()
                };
                
                console.log('Search filters:', filters);
                console.log('Search URL:', '{{ route($spref . "akademik.data-akademik-mahasiswa-search") }}');
                
                $.ajax({
                    url: '{{ route($spref . "akademik.data-akademik-mahasiswa-search") }}',
                    type: 'GET',
                    data: filters,
                    success: function(response) {
                        console.log('Search response:', response);
                        if (response.success) {
                            updateTableWithResults(response.data);
                            updateStatsWithResults(response.data);
                        } else {
                            console.error('Search failed:', response);
                        }
                        hideLoadingState();
                    },
                    error: function(xhr, status, error) {
                        console.error('Search AJAX error:', error);
                        console.error('Response:', xhr.responseText);
                        hideLoadingState();
                        // Fallback to form submission if AJAX fails
                        $('#filterForm').submit();
                    }
                });
            }

            // Function to update table with search results
            function updateTableWithResults(data) {
                const tbody = $('.table tbody');
                tbody.empty();
                
                if (data.length === 0) {
                    tbody.append(`
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <i class="fas fa-search fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">Tidak ada data yang ditemukan</p>
                            </td>
                        </tr>
                    `);
                    return;
                }
                
                data.forEach(function(item, index) {
                    const row = `
                        <tr>
                            <td data-label="No">${item.no}</td>
                            <td data-label="Nama Mahasantri">
                                <div class="d-flex align-items-center">
                                    <img src="${item.photo}" alt="${item.name}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #e9ecef;">
                                    <div>
                                        <span class="fw-bold">${item.name}</span>
                                        <br>
                                        <small class="text-muted">${item.email}</small>
                                    </div>
                                </div>
                            </td>
                            <td data-label="NIM">
                                ${item.numb_nim ? 
                                    `<span class="badge bg-light-success text-success">${item.numb_nim}</span>` : 
                                    `<span class="badge bg-light-warning text-warning">Belum Ada</span>`
                                }
                            </td>
                            <td data-label="Program Studi">${item.prodi_name}</td>
                            <td data-label="Kelas">${item.kelas_name}</td>
                            <td data-label="Semester">${item.semester}</td>
                            <td data-label="Takhasus">${item.takhasus}</td>
                            <td data-label="Status" class="text-center">
                                ${item.terminal_status}
                                ${item.is_terminal ? 
                                    `<div class="mt-1">
                                        <small class="text-muted" title="Terminal sejak: ${item.terminal_date}">
                                            <i class="fas fa-clock me-1"></i>${item.terminal_date}
                                        </small>
                                    </div>` : ''
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#editData${item.code}" class="btn btn-sm btn-primary" title="Edit Data Akademik">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#editProfileData${item.code}" class="btn btn-sm btn-success" title="Edit Profile Lengkap">
                                        <i class="fas fa-user-edit"></i>
                                    </a>
                                    ${item.is_terminal ? 
                                        `<button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#terminalModal${item.code}" title="Nonaktifkan Terminal">
                                            <i class="fas fa-unlock"></i>
                                        </button>` :
                                        `<button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#terminalModal${item.code}" title="Aktifkan Terminal">
                                            <i class="fas fa-ban"></i>
                                        </button>`
                                    }
                                </div>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }

            // Function to update stats with search results
            function updateStatsWithResults(data) {
                const totalCount = data.length;
                const withNimCount = data.filter(item => item.numb_nim && item.numb_nim !== 'Belum Ada').length;
                const withoutNimCount = totalCount - withNimCount;
                const withKelasCount = data.filter(item => item.kelas_name && item.kelas_name !== '-').length;
                
                // Update stats cards
                $('.bg-light-primary h3').text(totalCount);
                $('.bg-light-success h3').text(withNimCount);
                $('.bg-light-warning h3').text(withoutNimCount);
                $('.bg-light-info h3').text(withKelasCount);
            }

            // Function to hide loading state
            function hideLoadingState() {
                const submitBtn = $('#filterForm').find('button[type="submit"]');
                submitBtn.html('<i class="fas fa-search me-1"></i>Filter');
                submitBtn.prop('disabled', false);
                
                // Remove loading overlay
                $('.loading-overlay').remove();
            }

            // Show loading state function
            function showLoadingState() {
                const submitBtn = $('#filterForm').find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.html('<i class="fas fa-spinner fa-spin me-1"></i>Memfilter...');
                submitBtn.prop('disabled', true);
                
                // Add loading overlay to table
                $('.table-responsive').append('<div class="loading-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.8); display: flex; align-items: center; justify-content: center; z-index: 10;"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');
            }

            // Don't initialize DataTable since we're using custom real-time search
            // $('.table').DataTable({...});

            // Function to load takhasus options
            function loadTakhasusOptions(prodiId, takhasusSelect, currentTakhasusId) {
                // Clear current options
                takhasusSelect.html('<option value="">Pilih Takhasus</option>');
                
                if (!prodiId) {
                    return;
                }
                
                // Show loading
                takhasusSelect.html('<option value="">Loading...</option>');
                
                // Fetch takhasus options
                $.ajax({
                    url: '{{ route($spref . "akademik.get-takhasus-options") }}',
                    type: 'GET',
                    data: { prodi_id: prodiId },
                    success: function(data) {
                        takhasusSelect.html('<option value="">Pilih Takhasus</option>');
                        
                        if (data && data.length > 0) {
                            $.each(data, function(index, option) {
                                const selected = option.id == currentTakhasusId ? 'selected' : '';
                                takhasusSelect.append(`<option value="${option.id}" ${selected}>${option.name}</option>`);
                            });
                        } else {
                            takhasusSelect.append('<option value="" disabled>Tidak ada takhasus tersedia</option>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading takhasus:', error);
                        takhasusSelect.html('<option value="">Error loading takhasus</option>');
                    }
                });
            }

            // Handle program studi change and modal events for each mahasiswa
            @foreach ($mahasiswa as $item)
            // Handle program studi change event
            $('#edit_prodi_id{{ $item->code }}').on('change', function() {
                const prodiId = $(this).val();
                const takhasusSelect = $('#edit_takhasus_id{{ $item->code }}');
                const currentTakhasusId = '{{ $item->takhasus_id ?? "" }}';
                loadTakhasusOptions(prodiId, takhasusSelect, currentTakhasusId);
            });

            // Load takhasus options when modal is shown
            $('#editData{{ $item->code }}').on('shown.bs.modal', function() {
                const prodiId = $('#edit_prodi_id{{ $item->code }}').val();
                const takhasusSelect = $('#edit_takhasus_id{{ $item->code }}');
                const currentTakhasusId = '{{ $item->takhasus_id ?? "" }}';
                
                if (prodiId) {
                    loadTakhasusOptions(prodiId, takhasusSelect, currentTakhasusId);
                }
            });
            @endforeach

            // Handle import form submission with progress modal
            $('#importForm').on('submit', function(e) {
                e.preventDefault();
                
                // Validate file selection
                const fileInput = $('#import_file')[0];
                if (!fileInput.files.length) {
                    Swal.fire({
                        title: 'File Belum Dipilih!',
                        text: 'Silakan pilih file Excel (.xlsx) terlebih dahulu.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Hide import modal and show progress modal
                $('#importModal').modal('hide');
                $('#importProgressModal').modal('show');

                // Reset progress indicators
                updateProgress(0, 'Memulai proses import...', 0, 0, 0, 0);

                // Create FormData for file upload
                const formData = new FormData(this);

                // Start simulated progress (since we can't get real-time progress from server)
                let progress = 0;
                const progressInterval = setInterval(function() {
                    progress += Math.random() * 15;
                    if (progress > 90) {
                        progress = 90;
                        clearInterval(progressInterval);
                    }
                    updateProgress(progress, 'Memproses data Excel...', 0, 0, 0, 0);
                }, 500);

                // Submit form via AJAX
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        clearInterval(progressInterval);
                        
                        // Parse response if it's a string
                        if (typeof response === 'string') {
                            // Handle redirect response (success case)
                            updateProgress(100, 'Import berhasil diselesaikan!', 0, 0, 0, 0);
                            
                            setTimeout(function() {
                                $('#importProgressModal').modal('hide');
                                Swal.fire({
                                    title: 'Import Berhasil!',
                                    text: 'Data mahasiswa berhasil diimport. Halaman akan dimuat ulang.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(function() {
                                    window.location.reload();
                                });
                            }, 1000);
                        } else {
                            // Handle JSON response with statistics
                            const stats = response.stats || { imported: 0, skipped: 0, updated: 0, failed: 0 };
                            updateProgress(100, 'Import berhasil diselesaikan!', 
                                stats.imported, stats.skipped, stats.updated, stats.failed);
                            
                            setTimeout(function() {
                                $('#importProgressModal').modal('hide');
                                showImportResults(response);
                            }, 2000);
                        }
                    },
                    error: function(xhr, status, error) {
                        clearInterval(progressInterval);
                        
                        let errorMessage = 'Terjadi kesalahan saat mengimport data.';
                        
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                        
                        updateProgress(100, 'Import gagal!', 0, 0, 0, 1);
                        
                        setTimeout(function() {
                            $('#importProgressModal').modal('hide');
                            Swal.fire({
                                title: 'Import Gagal!',
                                text: errorMessage,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }, 1000);
                    }
                });
            });

            // Function to update progress indicators
            function updateProgress(percentage, status, imported, skipped, updated, failed) {
                $('#importProgressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
                $('#importProgressText').text(Math.round(percentage) + '%');
                $('#importStatus').text(status);
                $('#importedCount').text(imported);
                $('#skippedCount').text(skipped);
                $('#updatedCount').text(updated);
                $('#failedCount').text(failed);
                
                // Update progress bar color based on status
                const progressBar = $('#importProgressBar');
                progressBar.removeClass('bg-success bg-danger bg-warning');
                
                if (percentage === 100) {
                    if (failed > 0) {
                        progressBar.addClass('bg-warning');
                    } else {
                        progressBar.addClass('bg-success');
                    }
                }
            }

            // Function to show detailed import results
            function showImportResults(response) {
                let resultHtml = '<div class="text-start">';
                resultHtml += '<h6>📊 Statistik Import:</h6>';
                resultHtml += '<ul>';
                resultHtml += '<li>✅ Data berhasil diimport: ' + (response.stats?.imported || 0) + '</li>';
                resultHtml += '<li>⏭️ Data dilewati (duplikat): ' + (response.stats?.skipped || 0) + '</li>';
                resultHtml += '<li>🔄 Data diperbarui: ' + (response.stats?.updated || 0) + '</li>';
                resultHtml += '<li>❌ Data gagal diproses: ' + (response.stats?.failed || 0) + '</li>';
                resultHtml += '</ul>';
                
                if (response.stats?.errors && response.stats.errors.length > 0) {
                    resultHtml += '<h6 class="mt-3">⚠️ Detail Error:</h6>';
                    resultHtml += '<ul class="text-danger">';
                    response.stats.errors.forEach(function(error) {
                        resultHtml += '<li>' + error + '</li>';
                    });
                    resultHtml += '</ul>';
                }
                
                if (response.stats?.warnings && response.stats.warnings.length > 0) {
                    resultHtml += '<h6 class="mt-3">⚠️ Peringatan:</h6>';
                    resultHtml += '<ul class="text-warning">';
                    response.stats.warnings.forEach(function(warning) {
                        resultHtml += '<li>' + warning + '</li>';
                    });
                    resultHtml += '</ul>';
                }
                
                resultHtml += '</div>';
                
                Swal.fire({
                    title: 'Hasil Import',
                    html: resultHtml,
                    icon: response.stats?.failed > 0 ? 'warning' : 'success',
                    confirmButtonText: 'OK',
                    width: '600px'
                }).then(function() {
                    window.location.reload();
                });
            }
        });

        // Client-side validation functions for each modal
        @foreach ($mahasiswa as $item)
        function validateForm{{ $item->code }}() {
            const requiredFields = [
                { id: 'edit_numb_nim{{ $item->code }}', name: 'NIM' },
                { id: 'edit_prodi_id{{ $item->code }}', name: 'Program Studi' },
                { id: 'edit_kelas_id{{ $item->code }}', name: 'Kelas' },
                { id: 'edit_semester{{ $item->code }}', name: 'Semester' }
            ];

            for (let field of requiredFields) {
                const element = document.getElementById(field.id);
                if (!element.value.trim()) {
                    Swal.fire({
                        title: 'Field Wajib Kosong!',
                        text: field.name + ' harus diisi.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    element.focus();
                    return false;
                }
            }
            return true;
        }
        @endforeach
    </script>
@endsection
